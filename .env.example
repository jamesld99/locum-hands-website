# Copy to .env.local for local development. Do not put real secrets in this file.

# Optional salt for the short-lived in-memory rate-limit hash. The raw IP address is not stored.
RATE_LIMIT_SALT=

# Required for a real send. Without a key, the form reports that the message was not sent.
RESEND_API_KEY=

# Set to simulate only for a local dry run. This is ignored when VERCEL_ENV=production.
# EMAIL_DELIVERY=simulate
EMAIL_DELIVERY=

# Verified Locum Hands sender. Example only — use the address you verify in Resend.
ENQUIRY_FROM_EMAIL=Locum Hands <notifications@notify.locumhands.co.uk>
ENQUIRY_TO_EMAIL=hello@locumhands.co.uk
