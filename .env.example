# Copy to .env.local for local development. Do not put real secrets in this file.

# PostgreSQL connection string. Local files and Vercel temporary disk are not a receipt.
# Example local database:
# DATABASE_URL=postgresql://locum:locum@localhost:5432/locum_hands
DATABASE_URL=

# Optional salt for the short-lived rate-limit hash. The raw IP address is not stored.
RATE_LIMIT_SALT=

# Leave blank until Resend is connected. Without a key, enquiries are saved and the
# notification stays failed with EMAIL_NOT_CONFIGURED.
RESEND_API_KEY=

# Set to simulate only for a local dry run. This is ignored when VERCEL_ENV=production.
# EMAIL_DELIVERY=simulate
EMAIL_DELIVERY=

# Verified Locum Hands sender. Example only — use the address you verify in Resend.
ENQUIRY_FROM_EMAIL=Locum Hands <notifications@notify.locumhands.co.uk>
ENQUIRY_TO_EMAIL=hello@locumhands.co.uk
